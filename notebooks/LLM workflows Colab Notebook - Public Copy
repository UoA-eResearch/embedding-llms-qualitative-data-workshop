orting AI analysis\n","!pip install PyMuPDF --quiet\n","!pip install tools --quiet\n","!pip install accelerate --quiet\n","!pip install -U bitsandbytes --quiet\n","!pip install transformers --quiet\n","\n","import json\n","import torch\n","from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n","import warnings\n","import requests\n","import fitz  # PyMuPDF\n","import pandas as pd\n","from io import BytesIO\n","import urllib.parse"]},{"cell_type":"markdown","source":["## Data"],"metadata":{"id":"2AFSPwUTCsp7"}},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":375,"status":"ok","timestamp":1772151706998,"user":{"displayName":"Kyle Hemming","userId":"08577013907718569487"},"user_tz":-780},"id":"90bfbdc5","outputId":"751fff01-eeda-4d1e-f659-036f73bcbbe6"},"outputs":[{"output_type":"stream","name":"stdout","text":["Column names:\n","Index(['Quote', 'Speaker'], dtype='object')\n"]}],"source":["#### Load Parliamentary data\n","quotes = pd.read_csv(\"https://raw.githubusercontent.com/drhemming/LLM-1h-workshop-repository/main/Parliamentary_data/hansard_quotes_summer_llm_workshop_march.csv\", encoding='latin1')\n","\n","# Show column names of data\n","print(\"Column names:\")\n","print(quotes.columns)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":15,"status":"ok","timestamp":1772151707023,"user":{"displayName":"Kyle Hemming","userId":"08577013907718569487"},"user_tz":-780},"id":"Y3mVK-GCX5cJ","outputId":"86c0c268-f7f0-4890-85c9-af501dbb9f84"},"outputs":[{"output_type":"stream","name":"stdout","text":["The context of this bill is that this bill seeks to disestablish the Ministry for the Environment. It folds, and it folds into a mega-ministry alongside Transport, Housing, Urban Development, and parts of Internal Affairs. I think itÕs bizarre that now more than ever, we need to prioritise the environment first and foremost. We cannot deny climate change, and when we look at the bigger picture and focus on climate change and the environment, we cannot deny the weather events that weÕve seen across the country in the past month. In just the first weeks of 2026, there has been eight states of emergency that have been declared, matching the total for all of 2025. Recent storms across to Te Ika-a-M_uiÑthe North Island have brought record rainfall, flooding, evacuations, power outages, and loss of life. January storms alone caused multiple deaths from landslides and flooding, with record daily rainfall and Tauranga and Whitianga.\n"]}],"source":["# Display one quote of the data set\n","print(quotes.at[0, \"Quote\"])"]},{"cell_type":"code","source":["# Display the first rows of data\n","print(\"First 5 quotes:\")\n","print(quotes.head())"],"metadata":{"id":"OMbXoRM2_cVC","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1772148011672,"user_tz":-780,"elapsed":40,"user":{"displayName":"Kyle Hemming","userId":"08577013907718569487"}},"outputId":"86fc7ea3-6525-4a33-d234-a5a6147700ef"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["First 5 quotes:\n","                                               Quote  \\\n","0  The context of this bill is that this bill see...   \n","1  Equally, in terms of that scrutiny function, i...   \n","2  I remember being part of the Environment Commi...   \n","3  Point of order. Madam Speaker, this latest dia...   \n","4  The context of this bill is that this bill see...   \n","\n","                     Speaker  \n","0  HANA-RAWHITI MAIPI-CLARKE  \n","1         Hon Dr DUNCAN WEBB  \n","2               GLEN BENNETT  \n","3      Rt Hon Winston Peters  \n","4  HANA-RAWHITI MAIPI-CLARKE  \n"]}]},{"cell_type":"markdown","metadata":{"id":"505d4125"},"source":["## Prompts"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":91208,"status":"ok","timestamp":1772152148339,"user":{"displayName":"Kyle Hemming","userId":"08577013907718569487"},"user_tz":-780},"id":"261eca01","outputId":"65e43ba9-1cc6-4e5c-b2ed-99cc7ffe2e52"},"outputs":[{"output_type":"stream","name":"stdout","text":["Main Theme: environmental protection | Theme Justification: environmental reform | Political Spectrum: center-left | Spectrum Justification: This rhetoric aligns with environmental policies and reforms, but does not specifically tie to any named policy platform.\n","Main Theme: scrutiny deficiency | Theme Justification: lack of transparency | Political Spectrum: center-left | Spectrum Justification: The quote reflects a concern about regulatory quality, which is consistent with the center-left's emphasis on effective government oversight and accountability.\n","Main Theme: environment protection | Theme Justification: environmental activism | Political Spectrum: center-left | Spectrum Justification: This theme aligns with center-left policies as it emphasizes environmental protection and public opposition to corporate regulations.\n","Main Theme: off-topic | Theme Justification: diversionary tactic | Political Spectrum: center-right | Spectrum Justification: This theme aligns with the center-right political spectrum as it suggests a desire to maintain focus on the original debate, which could be interpreted as a criticism of opposition attempts to shift focus.\n","Main Theme: environmental protection | Theme Justification: environmental deregulation | Political Spectrum: center-left | Spectrum Justification: This quote aligns with center-left policies as it emphasizes the importance of environmental protection without directly advocating for specific New Zealand policy platforms.\n","Main Theme: dishonesty | Theme Justification: disrespect | Political Spectrum: center-right | Spectrum Justification: This quote does not align with a specific policy platform but reflects a center-right attitude towards maintaining integrity and decorum in Parliament.\n","Main Theme: Bill Scrutiny | Theme Justification: Bill Approval Process | Political Spectrum: center-right | Spectrum Justification: This stance aligns with center-right policies as it seeks a balanced approach to legislative scrutiny without overly complicating the bill's passage.\n","Main Theme: policy integration | Theme Justification: policy fragmentation | Political Spectrum: center-right | Spectrum Justification: This quote does not align with a specific policy platform but reflects a moderate view on government efficiency and coordination.\n","Main Theme: environmental protest | Theme Justification: environmental lobbying | Political Spectrum: far-left | Spectrum Justification: This rhetoric aligns with the far-left spectrum as it criticizes government policies on environmental issues and calls for direct action rather than relying on official channels.\n"]}],"source":["# prompts\n","quotes['main_theme'] = ''\n","quotes['political_spectrum'] = ''\n","\n","# Analyse data and stick analysis into each new column cell\n","for row in quotes.itertuples(index = True):\n","    quote = row.Quote\n","    speaker = row.Speaker\n","\n","    # Construct the LLM prompt for row-by-row analysis\n","    prompt_row_by_row = [\n","        {\n","            \"role\": \"system\",\n","            \"content\": \"You are an expert qualitative research assistant specializing in New Zealand parliamentary debates (Hansard data). Your task is to analyze a single quote and speaker and extract specific information in a strict JSON format.\"\n","        },\n","        {\n","            \"role\": \"user\",\n","            \"content\": f\"\"\"\n","                       The below message is text extracted from a new zealand parliament debate. More specifically, it is from one question within the debate.\n","                       Each line contains a quote from a speaker.\n","                       The JSON shoul